l=1;fillColor=#e8e8e8;strokeColor=#000000;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="3616" width="420" height="40" as="geometry"/></mxCell><mxCell id="n1073" value="+ id: string&#10;+ name: string&#10;+ email: string&#10;+ createdAt: Date" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="760" y="3656" width="420" height="84" as="geometry"/></mxCell><mxCell id="n1074" value="+ getAdmins(): AdminUser[]                            // GET /&#10;+ searchUsers(query): UserSearchResult[]               // GET /search&#10;+ createAdmin(name, email): AdminUser                  // POST /&#10;+ updateAdmin(id, name, email): AdminUser               // PATCH /:id&#10;+ promoteToAdmin(userId): AdminUser                     // POST /:id/promote&#10;+ demoteToUser(userId): void                            // POST /:id/demote" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="760" y="3740" width="420" height="116" as="geometry"/></mxCell><mxCell id="n1075" value="🎯 CORAÇÃO DO SISTEMA — busca de especialistas (fluxo real, hoje mockado)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#7a4a00;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="30" as="geometry"/></mxCell><mxCell id="n1076" value="HOJE — mockResponse() / mockProfessionals&#10;(app/chat/page.tsx)&#10;&#10;Resposta da IA gerada 100% no navegador,&#10;com dados fake. Nenhuma chamada real à API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="330" height="140" as="geometry"/></mxCell><mxCell id="n1077" value="PLANEJADO — chat.router.ts&#10;POST /api/chat/query  (endpoint não existe ainda)&#10;&#10;Vai receber a pergunta em linguagem natural&#10;e repassar para a camada de orquestração." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#7a4a00;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="340" height="140" as="geometry"/></mxCell><mxCell id="n1078" value="chateau-orchestration  (a criar — LangChain)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#7a4a00;" vertex="1" parent="1"><mxGeometry x="770" y="48" width="420" height="22" as="geometry"/></mxCell><mxCell id="n1079" value="«Interface»&#10;search-API" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="420" height="40" as="geometry"/></mxCell><mxCell id="n1080" value="+ query: string&#10;+ specialists: Specialist[]&#10;+ rankingScore: number" style="rounded=0;dashed=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="420" height="68" as="geometry"/></mxCell><mxCell id="n1081" value="+ search(query: string): Specialist[]   // planejado,&#10;  chamado a partir de POST /api/chat/query" style="rounded=0;dashed=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="770" y="178" width="420" height="36" as="geometry"/></mxCell><mxCell id="n1082" value="PLANEJADO — Modelo de IA / LLM&#10;(provedor ainda não definido)&#10;&#10;Recebe o prompt processado pelo LangChain&#10;e retorna o ranking de especialistas." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#7a4a00;" vertex="1" parent="1"><mxGeometry x="1230" y="70" width="400" height="140" as="geometry"/></mxCell><mxCell id="n1086" value="Legenda:  cinza = origem na UI   |   verde = Server Action (chama backend direto)   |   azul = Route Handler Next.js (repassa p/ backend)   |   roxo = callback NextAuth   |   branco «Interface» = API implementada no backend Express (nome + campos + métodos)   |   vermelho = mock atual (sem chamada à API)   |   laranja tracejado = fluxo/API planejada, ainda não existe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1300" height="90" as="geometry"/></mxCell><mxCell id="n1083" value="substitui o mock&#10;quando implementado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;dashed=1;strokeColor=#d79b00;fontColor=#7a4a00;" edge="1" parent="1" source="n1076" target="n1077"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1084" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;dashed=1;strokeColor=#d79b00;fontColor=#7a4a00;" edge="1" parent="1" source="n1077" target="n1079"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1085" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;dashed=1;strokeColor=#d79b00;fontColor=#7a4a00;" edge="1" parent="1" source="n1079" target="n1082"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1087" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;elbow=vertical;strokeColor=#666666;" edge="1" parent="1" source="n1004" target="n1018"><mxGeometry relative="1" as="geometr